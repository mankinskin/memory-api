{"rev":1,"ts":"2026-05-26T16:20:01.717981700+00:00","fields":{"body":"# --json machine surface\n\nThe `--json` flag on every `memory-api` CLI selects a stable machine surface. Tooling that consumes JSON output must never need to parse human prose or guess the shape of a list response.","feedback_helpful_count":0,"feedback_mixed_count":0,"feedback_not_helpful_count":0,"feedback_note_count":0,"feedback_unresolved_count":0,"file_kind":"spec-doc","order_key":1,"path_scopes":[],"repo_scopes":["memory-api"],"section":"json-machine-surface","sentence_anchors":[],"slug":"memory-api/recurring-principles/json-machine-surface/json-machine-surface/l1","source_end_line":3,"source_path":".spec/specs/f9c32554-9884-41c4-8b5b-d1d32b37e341/sections/json-machine-surface.md","source_repo":"memory-api","source_start_line":1,"state":"draft","title":"--json machine surface","type":"rule-entry"}}
